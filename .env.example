# Application
APP_MODE=api
PORT=8080
FRONT_URL=http://localhost:5173

# Docker Compose sets APP_MODE and CONSUMER_TOPIC for each worker service.
# For a manually started worker, set APP_MODE=worker and uncomment one queue:
# CONSUMER_TOPIC=ticket_processing
# CONSUMER_TOPIC=ticket_retry

# PostgreSQL connection and container initialization
# Use host "postgres" with Docker Compose; use localhost when running locally.
DATABASE_URL=postgres://triage:replace_me@postgres:5432/triage
POSTGRES_DB=triage
POSTGRES_USER=triage
POSTGRES_PASSWORD=replace_me

# Authentication and seeded support account
JWT_SECRET=replace_me_with_long_random_secret
SUPPORT_EMAIL=support@example.com
SUPPORT_PASSWORD=replace_me

# RabbitMQ connection
# Docker Compose overrides RABBITMQ_HOST with the rabbitmq service name.
RABBITMQ_HOST=localhost
RABBITMQ_USER=triage
RABBITMQ_PASSWORD=replace_me

# Triage model
# Set MODEL_PROVIDER=gemini and provide a Gemini API key to use Gemini.
# Gemini settings: MODEL_PROVIDER=gemini, MODEL_NAME=gemini-4-carbon,
# EMBEDDING_MODEL=gemini-embedding-2
MODEL_PROVIDER=fake
MODEL_NAME=fake_v1
EMBEDDING_MODEL=fake_embedding_v1
PROMPT_VERSION=v1
GEMINI_API_KEY=replace_me_with_gemini_api_key
